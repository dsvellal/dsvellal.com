---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import RecordQuote from './RecordQuote.astro';
import { capsuleHref, formatDate, isBeyond, isResponsibleAi, monthShort, section, THEME_LABELS, type Capsule } from '../../lib/record';
import { talkDate, talkHref, talksByRecord } from '../../lib/talks';
import { profile } from '../../data/profile';

interface Props {
  capsule: Capsule;
  eraLabel: string;
  prev?: Capsule;
  next?: Capsule;
}
const { capsule: c, eraLabel, prev, next } = Astro.props;
const sections = [
  { label: 'What would have happened', text: c.what_would_have_happened },
  { label: 'The call', text: c.the_call },
  { label: 'What I did', text: c.what_i_did },
  { label: 'What changed', text: c.what_changed },
].filter((s) => s.text && !/^not (applicable|in sources)/i.test(s.text));
const home = section(c);
const eraBase = isBeyond(c) ? home.href : `${home.href}/${c.era}`;
const crumbs = [
  { label: home.label, href: home.href },
  ...(isBeyond(c) ? [] : [{ label: eraLabel, href: eraBase }]),
  { label: c.year, href: `${eraBase}/${c.year}` },
  ...(c.month ? [{ label: monthShort(c.month), href: `${eraBase}/${c.year}/${c.month}` }] : []),
  { label: c.title },
];
const images = c.images ?? [];
const quotes = c.quotes ?? [];
const metrics = (c.metrics ?? []).slice(0, 3);
const linkedTalks = (await talksByRecord()).get(c.id) ?? [];
---

<Base title={c.title} description={c.summary ?? c.title} type="article">
  <article>
    <header class="wrap head">
      <Breadcrumbs items={crumbs} />
      <p class="meta label muted">
        {formatDate(c.date)}, {c.company}. {c.type}
      </p>
      <h1>{c.title}</h1>
      {c.summary && <p class="lede">{c.summary}</p>}
      {
        c.themes.length > 0 && (
          <ul class="themes" aria-label="Themes">
            {c.themes.map((t) => (
              <li class="label">{THEME_LABELS[t] ?? t}</li>
            ))}
          </ul>
        )
      }
      {
        isResponsibleAi(c) && (
          <p class="rai">
            <b>{profile.aiMark}</b>
            <span>Part of my work on {profile.focus}.</span>
          </p>
        )
      }
    </header>

    {
      metrics.length > 0 && (
        <section class="wrap metrics" aria-label="Key numbers">
          {metrics.map((m) => (
            <div class="metric">
              <p class="figure value">{m.value}</p>
              <p class="text">{m.label}</p>
              {m.context && <p class="context muted">{m.context}</p>}
            </div>
          ))}
        </section>
      )
    }

    <div class="wrap story">
      {
        sections.map((s) => (
          <section class="grid part">
            <h2 class="side">{s.label}</h2>
            <p class="main">{s.text}</p>
          </section>
        ))
      }

      <section class="grid part">
        <h2 class="side">Proof</h2>
        <div class="main">
          {
            images.length > 0 ? (
              <div class="shots">
                {images.map((img) => (
                  <figure>
                    <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" />
                    {img.pending && (
                      <figcaption class="label muted">
                        <span class="pending">Pending review</span>
                      </figcaption>
                    )}
                  </figure>
                ))}
              </div>
            ) : (
              <p class="muted">The original documents are held in my private record and can be shared on request.</p>
            )
          }
        </div>
      </section>

      {
        quotes.length > 0 && (
          <section class="grid part">
            <h2 class="side">What people said</h2>
            <div class="main voices">
              {quotes.map((q) => (
                <RecordQuote quote={q} />
              ))}
            </div>
          </section>
        )
      }

      {
        linkedTalks.length > 0 && (
          <section class="grid part">
            <h2 class="side">{linkedTalks.length === 1 ? 'Talk details' : 'Sessions'}</h2>
            <ul class="main talk-links">
              {linkedTalks.map((t) => (
                <li>
                  <a href={talkHref(t)}>{t.title}</a>
                  <span class="label muted">{talkDate(t)}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <nav class="wrap pager" aria-label="More from this era">
      {prev ? <a href={capsuleHref(prev)}>Newer: {prev.title}</a> : <span />}
      {next && <a class="next" href={capsuleHref(next)}>Older: {next.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .meta {
    margin-top: 2rem;
  }

  h1 {
    max-width: 72rem;
    margin-top: 0.75rem;
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 58rem;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.35;
    text-wrap: balance;
  }

  .themes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .themes li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--ink);
  }

  .rai {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    max-width: 44rem;
    margin-top: 1.25rem;
    padding-left: 1rem;
    border-left: 4px solid var(--accent);
    line-height: 1.4;
  }

  .rai b {
    padding: 0.15rem 0.5rem;
    background: var(--accent);
    font-size: var(--step--1);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 2rem var(--gutter);
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 4px solid var(--accent);
  }

  .value {
    font-size: var(--step-4);
    color: var(--accent);
  }

  .metric .text {
    max-width: 20rem;
    margin-top: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .metric .context {
    max-width: 20rem;
    margin-top: 0.35rem;
    font-size: var(--step--1);
  }

  .story {
    margin-top: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--ink);
  }

  .part {
    row-gap: 0.75rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .side,
  .main {
    grid-column: 1 / -1;
  }

  .side {
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  p.main,
  .main > p {
    max-width: 60rem;
    font-size: var(--step-1);
    line-height: 1.4;
    text-wrap: balance;
  }

  .shots {
    display: grid;
    gap: 2rem;
  }

  figure {
    margin: 0;
  }

  figure img {
    width: 100%;
    max-width: 48rem;
    border: 1px solid var(--rule);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 0.75rem;
  }

  .pending {
    padding: 0.15rem 0.5rem;
    background: var(--ink);
    color: var(--paper);
  }

  .voices {
    display: grid;
    gap: 2rem;
  }

  .talk-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .talk-links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0.5rem 0;
    font-weight: 700;
  }

  .pager {
    display: grid;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .side {
      grid-column: 1 / span 3;
    }

    .main {
      grid-column: 4 / span 9;
    }

    .pager {
      gap: 0.75rem;
    }

    .pager .next {
      justify-self: end;
      text-align: right;
    }
  }
</style>
