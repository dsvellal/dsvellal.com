---
import { formatDate } from '../../lib/record';

interface Props {
  quote: { text: string; role: string; company: string; date: string; capsule?: string };
  size?: 'large' | 'regular';
  link?: boolean;
}
const { quote, size = 'regular', link = false } = Astro.props;
---

<figure class:list={['rquote', size]}>
  <blockquote>
    <p>&ldquo;{quote.text}&rdquo;</p>
  </blockquote>
  <figcaption>
    <span class="role">{quote.role}</span>
    <span class="muted">{quote.company}, {formatDate(quote.date)}</span>
    {link && quote.capsule && <a class="label" href={`/record/c/${quote.capsule}`}>Read the capsule</a>}
  </figcaption>
</figure>

<style>
  .rquote {
    margin: 0;
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    max-width: 44rem;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .large blockquote p {
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.15;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 1rem;
    font-size: var(--step--1);
  }

  .role {
    font-weight: 700;
  }

  figcaption a {
    margin-top: 0.5rem;
  }
</style>
