---
import { capsuleHref, formatDate, THEME_LABELS, type Capsule } from '../../lib/record';
import { talkHref, talksByRecord } from '../../lib/talks';

interface Props {
  items: Capsule[];
  filters?: boolean;
  showSummary?: boolean;
  label: string;
}
const { items, filters = false, showSummary = true, label } = Astro.props;
const types = [...new Set(items.map((c) => c.type))].sort();
const themes = [...new Set(items.flatMap((c) => c.themes))].sort();
const listId = `list-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const linkedTalks = await talksByRecord();
// Line-tier talk events have no capsule page, so they link to their Giving back talk page instead.
const hrefFor = (c: Capsule) => {
  const own = capsuleHref(c);
  if (own) return own;
  const talk = linkedTalks.get(c.id);
  return talk?.length === 1 ? talkHref(talk[0]) : undefined;
};
---

<div class="capsule-list" data-capsule-list>
  {
    filters && items.length > 4 && (
      <div class="filters" data-filters hidden>
        <label>
          <span class="label">Type</span>
          <select data-filter="type" aria-controls={listId}>
            <option value="">All types</option>
            {types.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
        <label>
          <span class="label">Theme</span>
          <select data-filter="theme" aria-controls={listId}>
            <option value="">All themes</option>
            {themes.map((t) => <option value={t}>{THEME_LABELS[t] ?? t}</option>)}
          </select>
        </label>
        <p class="label muted" data-count aria-live="polite" />
      </div>
    )
  }
  <ol id={listId} aria-label={label}>
    {
      items.map((c) => {
        const href = hrefFor(c);
        return (
          <li data-type={c.type} data-themes={c.themes.join(' ')} class:list={{ line: !href }}>
            <span class="when label muted">{formatDate(c.date)}</span>
            <span class="what">
              {href ? <a href={href}>{c.title}</a> : <span>{c.title}</span>}
              {showSummary && href && c.summary && <span class="summary muted">{c.summary}</span>}
            </span>
            <span class="kind label muted">{c.type}</span>
          </li>
        );
      })
    }
  </ol>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-capsule-list]')) {
    const bar = root.querySelector<HTMLElement>('[data-filters]');
    if (!bar) continue;
    bar.hidden = false;
    const type = bar.querySelector<HTMLSelectElement>('[data-filter="type"]')!;
    const theme = bar.querySelector<HTMLSelectElement>('[data-filter="theme"]')!;
    const count = bar.querySelector<HTMLElement>('[data-count]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('li[data-type]')];
    const apply = () => {
      let shown = 0;
      for (const row of rows) {
        const ok =
          (!type.value || row.dataset.type === type.value) &&
          (!theme.value || (row.dataset.themes ?? '').split(' ').includes(theme.value));
        row.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = type.value || theme.value ? `${shown} of ${rows.length} shown` : '';
    };
    type.addEventListener('change', apply);
    theme.addEventListener('change', apply);
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .filters[hidden] {
    display: none;
  }

  .filters label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  select {
    min-width: 12rem;
    padding: 0.5rem 2rem 0.5rem 0.75rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  li[hidden] {
    display: none;
  }

  .what {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .line .what {
    font-weight: 500;
  }

  .summary {
    max-width: 44rem;
    font-size: var(--step--1);
    font-weight: 400;
  }

  @media (min-width: 48rem) {
    li {
      grid-template-columns: 9rem minmax(0, 1fr) 7rem;
      column-gap: var(--gutter);
      align-items: baseline;
    }

    .kind {
      text-align: right;
    }
  }
</style>
