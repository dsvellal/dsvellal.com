---
import TrendCard from './TrendCard.astro';
import { capsuleOrListHref, capsules, eraHref, monthShort, yearHref, type Era } from '../../lib/record';
import { ERA_SLOT, cardFor, byNewest } from '../../lib/cards';
import { talkEraHref, talks } from '../../lib/talks';

interface Props {
  era: Era;
  /** h1 on the era's own page, h2 on the Impact page. */
  level?: 1 | 2;
  /** On the Impact index, show only the newest few and link to the rest. Omit to show all. */
  limit?: number;
}

const { era, level = 2, limit } = Astro.props;
const all = (await capsules()).filter((c) => c.era === era.slug);
const cards = all.filter((c) => c.tier === 'public').map(cardFor).sort(byNewest);
const shown = limit ? cards.slice(0, limit) : cards;
const hiddenCount = cards.length - shown.length;
const aiCount = cards.filter((c) => c.mark).length;
const lines = all.filter((c) => c.tier === 'line');
const lineYears = [...new Set(lines.map((c) => c.year))].map((year) => ({ year, items: lines.filter((c) => c.year === year) }));
const eraTalks = (await talks()).filter((t) => t.era === era.slug).length;
const slot = ERA_SLOT[era.slug];
const H = level === 1 ? 'h1' : 'h2';
const headId = `${slot}-title`;
---

<section id={slot} class="era" aria-labelledby={headId}>
  <header class="wrap era-head">
    <p class="label years">{era.years}</p>
    <H id={headId} class:list={['era-name', { page: level === 1 }]}>{era.label}</H>
    <p class="era-line">{era.headline}</p>
    <p class="era-meta">
      <span><b>{cards.length}</b> with evidence</span>
      {
        aiCount > 0 && (limit ? (
          <a href={`${eraHref(era)}?ai=1`}>
            <b>{aiCount}</b> on Responsible AI
          </a>
        ) : (
          <button type="button" class="ai-only" aria-pressed="false">
            <b>{aiCount}</b> on Responsible AI only
          </button>
        ))
      }
      {lines.length > 0 && <span><b>{lines.length}</b> more, listed below</span>}
      {
        eraTalks > 0 && (
          <a href={talkEraHref(era.slug)}>
            <b>{eraTalks}</b> talks and sessions
          </a>
        )
      }
    </p>
    <nav class="era-years" aria-label={`${era.label} by year`}>
      {era.year_layers.map((y) => <a href={yearHref(era, y.year)}>{y.year}</a>)}
    </nav>
  </header>

  <ol class="wrap tc-grid" aria-label={`${era.label}, newest first`}>
    {
      shown.map((c) => (
        <li data-ai={c.mark ? '' : undefined}>
          <TrendCard card={c} />
        </li>
      ))
    }
  </ol>

  {
    hiddenCount > 0 && (
      <p class="wrap see-all">
        <a href={eraHref(era)}>See all {cards.length} at {era.label} &rarr;</a>
      </p>
    )
  }

  {
    lines.length > 0 && (
      <details class="wrap also">
        <summary>
          Also at {era.label}: {lines.length} more entries without a card
        </summary>
        {lineYears.map((y) => (
          <div class="also-year">
            <p class="figure">{y.year}</p>
            <ul>
              {y.items.map((c) => (
                <li>
                  <a href={capsuleOrListHref(c)}>
                    <span class="label muted">{c.month ? monthShort(c.month) : 'Year'}</span>
                    <span>{c.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </details>
    )
  }
</section>

<script>
  // "Responsible AI only" hides entries without the mark. ?ai=1 opens the page already filtered.
  document.querySelectorAll<HTMLButtonElement>('.ai-only').forEach((button) => {
    const section = button.closest('section');
    if (!section) return;
    const apply = (on: boolean) => {
      button.setAttribute('aria-pressed', String(on));
      section.querySelectorAll<HTMLElement>('.tc-grid > li').forEach((li) => {
        li.hidden = on && !li.hasAttribute('data-ai');
      });
    };
    button.addEventListener('click', () => {
      const on = button.getAttribute('aria-pressed') !== 'true';
      apply(on);
      const url = new URL(location.href);
      if (on) url.searchParams.set('ai', '1');
      else url.searchParams.delete('ai');
      history.replaceState(null, '', url);
    });
    if (new URLSearchParams(location.search).get('ai') === '1') apply(true);
  });
</script>

<style>
  .era {
    scroll-margin-top: 4.5rem;
  }

  .era-head {
    display: grid;
    gap: 0.75rem;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .years {
    color: var(--accent);
  }

  .era-name {
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .era-name.page {
    font-size: var(--step-5);
  }

  .era-line {
    max-width: 58rem;
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .era-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--step--1);
  }

  .era-meta b {
    font-size: var(--step-0);
  }

  .era-meta a {
    font-weight: 600;
  }

  .ai-only {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .ai-only[aria-pressed='true'] {
    padding: 0 0.4rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }

  .ai-only:active {
    transform: translateY(1px);
  }

  .era-years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: var(--step--1);
    font-weight: 700;
  }

  .tc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: clamp(1rem, 2.4vw, 1.75rem);
    margin: 0 auto;
    padding-top: 0;
    padding-bottom: 0;
    list-style: none;
  }

  .see-all {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--step--1);
    font-weight: 800;
  }

  .see-all a {
    text-decoration-color: var(--accent);
  }

  .also {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .also summary {
    padding: 1rem 0;
    font-weight: 700;
    cursor: pointer;
  }

  .also-year {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 0 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .also-year .figure {
    font-size: var(--step-1);
    color: var(--accent);
  }

  .also ul {
    display: grid;
    gap: 0.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .also li a {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.4rem 0;
    color: inherit;
    text-decoration: none;
  }

  .also li a:hover span:last-child {
    text-decoration: underline;
  }

  @media (min-width: 56rem) {
    .also ul {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
