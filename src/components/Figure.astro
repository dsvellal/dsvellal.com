---
import { claim } from '../data/claims';

interface Props {
  id: string;
  size?: 'hero' | 'large' | 'medium';
  showContext?: boolean;
}

const { id, size = 'large', showContext = false } = Astro.props;
const c = claim(id);
---

<div class:list={['fig', size]}>
  <p class="figure value">{c.value}</p>
  <p class="text">{c.label}</p>
  {showContext && <p class="context muted">{c.context}</p>}
</div>

<style>
  .value {
    color: var(--accent);
  }

  .hero .value {
    font-size: var(--step-5);
  }

  .large .value {
    font-size: var(--step-4);
  }

  .medium .value {
    font-size: var(--step-3);
    color: var(--ink);
  }

  .text {
    max-width: 28rem;
    margin-top: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .context {
    max-width: 28rem;
    margin-top: 0.5rem;
    font-size: var(--step--1);
  }
</style>
