---
import { arc, arcThemes } from '../../data/story';
import { capsules, recordHref } from '../../lib/record';

const all = await capsules();
const steps = await Promise.all(
  arc.map(async (s, i) => ({
    ...s,
    rise: i + 1,
    now: i === arc.length - 1,
    milestoneHref: await recordHref(s.capsule),
    themes: arcThemes.map((t) => ({
      ...t,
      count: all.filter((c) => c.era === s.era && c.themes.includes(t.id)).length,
    })),
  })),
);
const max = Math.max(...steps.flatMap((s) => s.themes.map((t) => t.count)), 1);
const total = all.filter((c) => c.lane === 'work').length;
const columns = steps.map((s) => `${(s.end - s.start).toFixed(1)}fr`).join(' ');
---

<figure class="arc" aria-labelledby="arc-caption">
  <div class="arc-body">
    <dl class="arc-key" aria-hidden="true">
      {arcThemes.map((t) => <dt class:list={{ ai: t.id === 'ai' }}>{t.label}</dt>)}
    </dl>
    <ol class="arc-steps" style={`--columns: ${columns}`}>
      {
        steps.map((s) => (
          <li class:list={['step', { now: s.now }]} style={`--rise: ${s.rise}`}>
            <div class="step-text">
              <h3>
                <a href={`/impact/${s.era}`}>{s.employer}</a>
              </h3>
              <p class="years muted">{s.years}</p>
              <p class="scope">{s.scope}</p>
              <p class="milestone">
                <a href={s.milestoneHref}>{s.milestone}</a>
              </p>
            </div>
            <span class="riser" aria-hidden="true" />
            <dl class="themes">
              {s.themes.map((t) => (
                <div class:list={['theme', { ai: t.id === 'ai' }]}>
                  <dt>{t.label}</dt>
                  <dd>
                    <span class="track">
                      <span class="fill" style={`width: ${(t.count / max) * 100}%`} />
                    </span>
                    <span class="n">{t.count}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption id="arc-caption" class="muted">
    Each step is a wider scope of work than the one before; the heights show order, not size. The bars count entries in my
    work record by theme, out of {total}, and one entry can carry several themes. Most of the AI work dates from 2025, on
    top of the quality and delivery work that came first.
  </figcaption>
</figure>

<style>
  .arc {
    margin: 0;
  }

  .arc-key {
    display: none;
  }

  .arc-steps {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  h3 {
    font-size: var(--step-1);
    font-weight: 800;
  }

  .years {
    margin-top: 0.2rem;
    font-size: var(--step--1);
  }

  .scope {
    margin-top: 0.5rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .milestone {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .riser {
    display: block;
    width: calc(28% + var(--rise) * 14%);
    height: 0.5rem;
    background: var(--ink);
  }

  .now .riser {
    background: var(--accent);
  }

  .themes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem var(--gutter);
    margin: 0;
  }

  .theme {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: center;
    column-gap: 0.5rem;
    font-size: var(--step--1);
  }

  .theme dd {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }

  .track {
    flex: 1;
    max-width: 6rem;
  }

  .fill {
    display: block;
    min-width: 1px;
    height: 0.4rem;
    background: var(--ink-2);
  }

  .ai .fill {
    background: var(--accent);
  }

  .n {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  figcaption {
    max-width: 44rem;
    margin-top: 2rem;
    font-size: var(--step--1);
  }

  @media (min-width: 64rem) {
    .arc-body {
      display: grid;
      grid-template-columns: 6rem minmax(0, 1fr);
      column-gap: var(--gutter);
      align-items: end;
    }

    .arc-key {
      display: grid;
      gap: 0.4rem;
      margin: 0 0 0;
      font-size: var(--step--1);
      font-weight: 600;
      color: var(--ink-2);
    }

    .arc-key dt {
      height: 1.3rem;
      line-height: 1.3rem;
    }

    .arc-key .ai {
      color: var(--ink);
    }

    .arc-steps {
      grid-template-columns: var(--columns);
      gap: 0;
      align-items: end;
    }

    .step {
      grid-template-rows: auto auto auto;
      align-content: end;
      gap: 0;
      height: 100%;
      padding: 0;
      border-top: 0;
      border-left: 1px solid var(--rule);
    }

    .step-text {
      padding: 0 0.75rem 0.75rem;
    }

    .riser {
      width: 100%;
      height: calc(var(--rise) * 1.5rem);
      border-top: 2px solid var(--ink);
      background: #ececec;
    }

    .now .riser {
      border-top: 4px solid var(--accent);
      background: color-mix(in srgb, var(--accent) 22%, var(--paper));
    }

    .themes {
      grid-template-columns: 1fr;
      padding: 0.75rem 0.75rem 0;
    }

    .theme {
      grid-template-columns: minmax(0, 1fr);
      height: 1.3rem;
    }

    .theme dt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .track {
      max-width: 4.5rem;
    }
  }
</style>
