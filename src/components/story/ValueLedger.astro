---
import { claim } from '../../data/claims';
import { ledger } from '../../data/story';
import { claimHref } from '../../lib/record';

interface Props {
  variant?: 'compact' | 'full';
  /** Claim ids already shown elsewhere on the page. */
  exclude?: string[];
}

const { variant = 'compact', exclude = [] } = Astro.props;
const groups = (
  await Promise.all(
    ledger.map(async (g) => ({
      group: g.group,
      rows: await Promise.all(
        (variant === 'full' ? g.rows : g.rows.filter((id) => !exclude.includes(id)).slice(0, g.lead)).map(async (id) => {
          const c = claim(id);
          return { c, href: await claimHref(c) };
        }),
      ),
    })),
  )
).filter((g) => g.rows.length > 0);
---

<div class:list={['ledger', variant]}>
  <table>
    <caption class="visually-hidden">Value delivered, with my part in it</caption>
    <thead>
      <tr>
        <th scope="col">Figure</th>
        <th scope="col">What it measures</th>
        <th scope="col">When</th>
        <th scope="col">My part</th>
      </tr>
    </thead>
    {
      groups.map((g) => (
        <tbody>
          <tr class="group">
            <th scope="rowgroup" colspan="4">
              {g.group}
            </th>
          </tr>
          {g.rows.map(({ c, href }) => (
            <tr>
              <th scope="row" class="value figure">
                {href ? <a href={href}>{c.value}</a> : c.value}
              </th>
              <td class="what">
                {c.label}
                {variant === 'full' && <span class="context muted">{c.context}</span>}
              </td>
              <td class="when">{c.year}</td>
              <td class="role">{c.role}</td>
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
  <p class="rule-note muted">
    Nothing here is added up. Each figure keeps the currency and unit it was reported in.
  </p>
</div>

<style>
  table {
    display: block;
    width: 100%;
    margin-top: 1.5rem;
    border-collapse: collapse;
  }

  thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  tbody {
    display: grid;
  }

  tr {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.35rem 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }

  .group {
    display: block;
    padding: 1.75rem 0 0.5rem;
    border-top: 0;
  }

  .group th {
    display: block;
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-align: left;
  }

  th,
  td {
    padding: 0;
    text-align: left;
    vertical-align: baseline;
  }

  .value {
    grid-column: 1 / -1;
    font-size: var(--step-2);
    font-weight: 800;
  }

  .value a {
    text-decoration-thickness: 2px;
  }

  .what {
    grid-column: 1 / -1;
    max-width: 34rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .context {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--step--1);
    font-weight: 400;
  }

  .when,
  .role {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .when {
    grid-column: 1;
  }

  .role {
    grid-column: 2;
  }

  @media (max-width: 47.99rem) {
    .when:empty,
    .role:empty {
      display: none;
    }
  }

  .rule-note {
    max-width: 40rem;
    margin-top: 1.5rem;
    font-size: var(--step--1);
  }

  @media (min-width: 48rem) {
    table {
      display: table;
      table-layout: fixed;
    }

    thead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      display: table-header-group;
    }

    thead th {
      padding-bottom: 0.6rem;
      font-size: var(--step--1);
      font-weight: 600;
      color: var(--ink-2);
      border-bottom: 1px solid var(--ink);
    }

    thead th:nth-child(1) {
      width: 24%;
    }

    thead th:nth-child(2) {
      width: 46%;
    }

    thead th:nth-child(3) {
      width: 12%;
    }

    thead th:nth-child(4) {
      width: 18%;
    }

    tbody {
      display: table-row-group;
    }

    tr {
      display: table-row;
    }

    .group th {
      display: table-cell;
      padding: 1.75rem 0 0.6rem;
    }

    tr:not(.group) > * {
      padding: 0.9rem 1rem 0.9rem 0;
      border-top: 1px solid var(--rule);
      vertical-align: top;
    }

    .value {
      font-size: var(--step-2);
      line-height: 1;
    }

    .when,
    .role {
      padding-top: 1.1rem;
    }
  }
</style>
