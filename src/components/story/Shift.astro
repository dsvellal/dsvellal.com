---
import { claim } from '../../data/claims';
import { claimHref } from '../../lib/record';

interface Props {
  id: string;
  size?: 'compact' | 'full';
}

const { id, size = 'compact' } = Astro.props;
const c = claim(id);
const href = await claimHref(c);
const ch = c.change;
const top = ch ? (ch.max ?? Math.max(ch.from, ch.to)) : 1;
// A sliver stays visible when the new value is tiny, such as 0.11 against 37.
const pct = (v: number) => `${Math.max(0.8, (v / top) * 100)}%`;
---

<figure class:list={['shift', size]}>
  <p class="value figure">{c.value}</p>
  {
    ch && (
      <div class="bars" role="img" aria-label={`Before ${ch.from}, after ${ch.to}, on a scale to ${top}`}>
        <span class="bar before" style={`width: ${pct(ch.from)}`} />
        <span class="bar after" style={`width: ${pct(ch.to)}`} />
      </div>
    )
  }
  <figcaption>
    <span class="what">{c.label}</span>
    {size === 'full' && <span class="context muted">{c.context}</span>}
    <span class="meta">
      {c.year && <span class="muted">{c.year}</span>}
      {
        href && (
          <a href={href}>
            Evidence<span class="visually-hidden">: {c.value} {c.label}</span>
          </a>
        )
      }
    </span>
  </figcaption>
</figure>

<style>
  .shift {
    margin: 0;
  }

  .value {
    font-size: var(--step-3);
  }

  .compact .value {
    font-size: var(--step-2);
  }

  .bars {
    display: grid;
    gap: 3px;
    margin-top: 0.75rem;
  }

  .bar {
    display: block;
    height: 0.5rem;
  }

  .before {
    background: #b8b8b8;
  }

  .after {
    background: var(--accent);
  }

  figcaption {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .what {
    max-width: 24rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .compact .what {
    font-size: var(--step--1);
  }

  .context {
    max-width: 24rem;
    font-size: var(--step--1);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    font-size: var(--step--1);
  }

  .meta a {
    font-weight: 600;
  }
</style>
