---
import { claim } from '../../data/claims';
import { adoptionLadder } from '../../data/story';
import { claimHref } from '../../lib/record';

interface Props {
  /** Claim ids already shown elsewhere on the page. */
  exclude?: string[];
}

const { exclude = [] } = Astro.props;
const visible = adoptionLadder
  .map((s) => ({ ...s, claims: s.claims.filter((id) => !exclude.includes(id)) }))
  .filter((s) => s.claims.length > 0);
const steps = await Promise.all(
  visible.map(async (s, i) => ({
    ...s,
    rise: i + 1,
    now: i === visible.length - 1,
    items: await Promise.all(
      s.claims.map(async (id) => {
        const c = claim(id);
        return { c, href: await claimHref(c) };
      }),
    ),
  })),
);
---

<figure class="ladder" aria-labelledby="ladder-caption">
  <ol class="steps">
    {
      steps.map((s) => (
        <li class:list={['step', { now: s.now }]} style={`--rise: ${s.rise}`}>
          <div class="step-text">
            <h3>{s.step}</h3>
            <p class="note muted">{s.note}</p>
            <ul class="items">
              {s.items.map(({ c, href }) => (
                <li>
                  <a href={href} class="value figure">
                    {c.value}
                  </a>
                  <span class="what">{c.label}</span>
                  <span class="meta muted">{c.year}</span>
                </li>
              ))}
            </ul>
          </div>
          <span class="riser" aria-hidden="true" />
        </li>
      ))
    }
  </ol>
  <figcaption id="ladder-caption" class="muted">
    Each step counts a different group of people, so the steps are not subsets of one another. The last step is AI in
    day-to-day regulated work.
  </figcaption>
</figure>

<style>
  .ladder {
    margin: 0;
  }

  .steps {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  h3 {
    font-size: var(--step-1);
    font-weight: 800;
  }

  .note {
    margin-top: 0.2rem;
    font-size: var(--step--1);
  }

  .items {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .items li {
    display: grid;
    gap: 0.3rem;
  }

  .value {
    font-size: var(--step-3);
    text-decoration: none;
  }

  .value:hover {
    color: var(--accent);
  }

  .what {
    max-width: 18rem;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.3;
  }

  .meta {
    font-size: var(--step--1);
  }

  .riser {
    display: block;
    width: calc(40% + var(--rise) * 15%);
    height: 0.5rem;
    background: var(--ink);
  }

  .now .riser {
    background: var(--accent);
  }

  figcaption {
    max-width: 44rem;
    margin-top: 2rem;
    font-size: var(--step--1);
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      align-items: end;
    }

    .step {
      align-content: end;
      gap: 0;
      height: 100%;
      padding: 0;
      border-top: 0;
      border-left: 1px solid var(--rule);
    }

    .step-text {
      padding: 0 1rem 1rem;
    }

    .riser {
      width: 100%;
      height: calc(var(--rise) * 1.75rem);
      border-top: 2px solid var(--ink);
      background: #ececec;
    }

    .now .riser {
      border-top: 4px solid var(--accent);
      background: color-mix(in srgb, var(--accent) 22%, var(--paper));
    }
  }
</style>
