---
interface Props {
  to: string;
}
const { to } = Astro.props;
const target = new URL(to, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>This page has moved to <a href={to}>{target.href}</a>.</p>
  </body>
</html>
