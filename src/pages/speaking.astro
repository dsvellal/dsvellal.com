---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import { talks, topics } from '../data/talks';
import { profile } from '../data/profile';
import { claim, sessionsByEra } from '../data/claims';

const total = claim('talks-count');
const people = claim('talks-attendees');
const lede =
  `Since 2010 I have taught more than ${total.value.replace('+', '')} sessions to over ${people.value.replace('+', '')} people, at every company I have worked for and at more than 25 colleges. ` +
  'I teach what I practice: writing software that lasts, measuring delivery honestly, and using AI responsibly in regulated engineering.';

const sorted = [...talks].sort((a, b) => Number(b.year) - Number(a.year));
const byYear = sorted.reduce<Record<string, typeof talks>>((acc, t) => {
  (acc[t.year] ??= []).push(t);
  return acc;
}, {});
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<Base
  title="Speaking"
  description="Talks, workshops and courses by Datta Vellal on AI in regulated engineering, engineering flow, craftsmanship and careers."
>
  <header class="wrap grid page-head">
    <div class="intro">
      <h1>Speaking and teaching</h1>
      <p class="lede">
        {lede}
      </p>
    </div>
  </header>

  <section class="wrap grid figs" aria-label="Speaking in numbers">
    <div><Figure id="talks-count" size="large" showContext /></div>
    <div><Figure id="talks-attendees" size="large" showContext /></div>
  </section>

  <section class="wrap eras" aria-labelledby="eras-title">
    <hr class="rule rule--accent" />
    <h2 id="eras-title">Across my career</h2>
    <ol class="era-list">
      {
        sessionsByEra.map((e) => (
          <li>
            <p class="era-years label">{e.years}</p>
            <p class="era-employer">{e.employer}</p>
            <p class="figure era-count">{e.sessions}</p>
            <p class="era-unit label">sessions</p>
            <p class="muted era-highlight">{e.highlight}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap now" aria-labelledby="now-title">
    <hr class="rule" />
    <h2 id="now-title">Teaching AI now</h2>
    <div class="grid now-figs">
      <div><Figure id="ai-people-trained" size="medium" showContext /></div>
      <div><Figure id="ai-sessions-rating" size="medium" showContext /></div>
      <div><Figure id="pu-program" size="medium" showContext /></div>
    </div>
    <div class="now-quote">
      <QuoteBlock id="q-analytics" size="large" />
    </div>
  </section>

  <section class="wrap topics" aria-labelledby="topics-title">
    <hr class="rule rule--accent" />
    <h2 id="topics-title">Topics</h2>
    <dl class="topic-list">
      {
        topics.map((t) => (
          <div>
            <dt>{t.title}</dt>
            <dd class="muted">{t.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap grid talks" aria-labelledby="talks-title">
    <h2 id="talks-title" class="talks-title">Selected talks</h2>
    <div class="talks-list">
      {
        years.map((year) => (
          <div class="year-group">
            <p class="year figure">{year}</p>
            <ul>
              {byYear[year].map((t) => (
                <li>
                  <span class="talk-title">{t.title}</span>
                  <span class="muted talk-meta">
                    {t.format}, {t.venue}
                    {t.detail && <span class="talk-detail">{`. ${t.detail}.`}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap invite-block" aria-labelledby="invite-title">
    <hr class="rule" />
    <h2 id="invite-title">Organizing an event?</h2>
    <p class="muted">
      Write to <a href={`mailto:${profile.email}`}>{profile.email}</a> with the audience, format and date. A short bio and
      headshot are available on request.
    </p>
  </section>
</Base>

<style>
  section {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  .page-head {
    margin-top: clamp(2rem, 6vw, 5rem);
  }

  .intro {
    grid-column: 1 / -1;
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 36rem;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .figs {
    row-gap: 2.5rem;
  }

  .figs > div {
    grid-column: 1 / -1;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  h2 {
    font-size: var(--step-3);
    font-weight: 800;
  }

  .topics h2 {
    margin-top: 1.5rem;
  }

  .topic-list {
    display: grid;
    gap: 2rem var(--gutter);
    margin: 2.5rem 0 0;
  }

  dt {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  dd {
    max-width: 30rem;
    margin: 0.5rem 0 0;
  }

  .talks {
    row-gap: 2rem;
  }

  .talks-title,
  .talks-list {
    grid-column: 1 / -1;
  }

  .year-group {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    column-gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--ink);
  }

  .year {
    font-size: var(--step-2);
    color: var(--accent);
  }

  .year-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .year-group li {
    display: flex;
    flex-direction: column;
  }

  .year-group li + li {
    margin-top: 1.1rem;
  }

  .talk-title {
    font-weight: 700;
    line-height: 1.3;
  }

  .talk-meta {
    font-size: var(--step--1);
  }

  .invite-block h2 {
    margin-top: 2rem;
    font-size: var(--step-2);
  }

  .invite-block p {
    max-width: 34rem;
    margin-top: 1rem;
  }

  .eras h2,
  .now h2 {
    margin-top: 1.5rem;
  }

  .era-list {
    display: grid;
    gap: 2rem var(--gutter);
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .era-list li {
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  .era-employer {
    margin-top: 0.35rem;
    line-height: 1.2;
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .era-count {
    margin-top: 1rem;
    font-size: var(--step-4);
    color: var(--accent);
    line-height: 1;
  }

  .era-highlight {
    margin-top: 0.75rem;
    font-size: var(--step--1);
  }

  .now-figs {
    row-gap: 2rem;
    margin-top: 2.5rem;
  }

  .now-figs > div {
    grid-column: 1 / -1;
  }

  .now-quote {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  @media (min-width: 48rem) {
    .era-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .era-employer {
      min-height: 2.4em;
    }

    .now-figs > div {
      grid-column: span 4;
    }
  }

  @media (min-width: 48rem) {
    .intro {
      grid-column: 1 / span 9;
    }

    .figs > div {
      grid-column: span 6;
    }

    .topic-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .talks-title {
      grid-column: 1 / span 4;
    }

    .talks-list {
      grid-column: 5 / span 8;
    }
  }
</style>
