---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/record/Breadcrumbs.astro';
import { eraHref, eras, type Era } from '../../lib/record';
import { reachOf, talkHref, talks, talkYearHref, yearsOf } from '../../lib/talks';

export async function getStaticPaths() {
  const all = await talks();
  return (await eras())
    .filter((e) => e.lane === 'work' && all.some((t) => t.era === e.slug))
    .map((era) => ({ params: { era: era.slug }, props: { era } }));
}

const { era } = Astro.props as { era: Era };
const list = (await talks()).filter((t) => t.era === era.slug);
const years = yearsOf(list);
const reach = reachOf(list);
const figures = [
  { value: String(list.length), label: 'talks, workshops and events' },
  ...(reach.people ? [{ value: `${reach.people.toLocaleString('en-US')}+`, label: 'people where a headcount survives' }] : []),
  ...(reach.withFeedback ? [{ value: String(reach.withFeedback), label: 'sessions with participant feedback' }] : []),
];
---

<Base
  title={`Talks at ${era.label}, ${era.years}`}
  description={`${list.length} talks, workshops and teaching sessions at ${era.label}, ${era.years}, newest first.`}
>
  <header class="wrap head">
    <Breadcrumbs items={[{ label: 'Giving back', href: '/giving-back' }, { label: era.label }]} />
    <h1>{era.label}</h1>
    <p class="lede">
      {era.years}. Talks, workshops, training and judging, newest first. The work itself is in
      <a href={eraHref(era)}>Impact at {era.label}</a>.
    </p>
  </header>

  <section class="wrap figs" aria-label="In numbers">
    {
      figures.map((f) => (
        <div>
          <p class="figure value">{f.value}</p>
          <p class="text">{f.label}</p>
        </div>
      ))
    }
  </section>

  <section class="wrap grid block" aria-labelledby="years-title">
    <h2 id="years-title" class="side">Year by year</h2>
    <ol class="years main">
      {
        years.map((y) => (
          <li>
            <a class="year figure" href={talkYearHref(era.slug, y.year)}>
              {y.year}
            </a>
            <div>
              <ul class="titles">
                {y.talks.slice(0, 3).map((t) => (
                  <li>
                    <a href={talkHref(t)}>{t.title}</a>
                  </li>
                ))}
              </ul>
              <p class="label muted">
                {y.talks.length} {y.talks.length === 1 ? 'session' : 'sessions'}
                {y.talks.length > 3 && <a href={talkYearHref(era.slug, y.year)}> See all</a>}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  h1 {
    margin-top: 1.5rem;
    font-size: var(--step-5);
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .lede {
    max-width: 44rem;
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 2rem var(--gutter);
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 4px solid var(--accent);
  }

  .value {
    font-size: var(--step-4);
    color: var(--accent);
  }

  .figs .text {
    max-width: 18rem;
    margin-top: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .block {
    margin-top: clamp(3rem, 7vw, 5rem);
    row-gap: 1.25rem;
  }

  .side,
  .main {
    grid-column: 1 / -1;
  }

  .side {
    font-size: var(--step-2);
  }

  .years {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .years > li {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--gutter);
    align-items: baseline;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .year {
    font-size: var(--step-2);
  }

  .titles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .titles li + li {
    margin-top: 0.35rem;
  }

  .titles a {
    font-weight: 600;
  }

  .years .label {
    margin-top: 0.5rem;
  }

  @media (min-width: 48rem) {
    .side {
      grid-column: 1 / span 3;
    }

    .main {
      grid-column: 4 / span 9;
    }
  }
</style>
