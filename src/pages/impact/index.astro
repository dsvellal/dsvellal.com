---
import Base from '../../layouts/Base.astro';
import EraBand from '../../components/record/EraBand.astro';
import CapsuleList from '../../components/record/CapsuleList.astro';
import ValueLedger from '../../components/story/ValueLedger.astro';
import { capsules, eras } from '../../lib/record';

const work = (await eras()).filter((e) => e.lane === 'work');
const max = Math.max(...work.map((e) => e.events), 1);
const totalEvents = work.reduce((n, e) => n + e.events, 0);
const documented = (await capsules()).filter((c) => c.lane === 'work' && c.tier === 'public');
const years = [...new Set(documented.map((c) => c.year))].map((year) => ({
  year,
  items: documented.filter((c) => c.year === year),
}));
---

<Base
  title="Impact"
  description="Every contribution at work since 2007, documented with sources and feedback. Browse by company, year and month."
>
  <header class="wrap head">
    <h1>Impact</h1>
    <p class="lede">
      {totalEvents} events since 2007, each documented with its date, result and what people said. Pick a company to
      go year by year, or read the <a href="#all">{documented.length} documented in depth</a>, newest first.
    </p>
  </header>

  <section class="wrap bands" aria-labelledby="bands-title">
    <h2 id="bands-title" class="visually-hidden">Career eras</h2>
    <div class="band-head label muted" aria-hidden="true">
      <span>Company</span><span>Events</span><span>Headline</span>
    </div>
    <ol class="band-list">
      {
        work.map((e) => (
          <li>
            <EraBand era={e} max={max} />
          </li>
        ))
      }
    </ol>
  </section>

  <section id="value" class="wrap value" aria-labelledby="value-title">
    <h2 id="value-title">What it was worth</h2>
    <p class="muted all-note">
      Every figure on this site that measures a result, with my part in it and what backs it. Each links to its entry in
      the record.
    </p>
    <div class="value-body">
      <ValueLedger variant="full" />
    </div>
  </section>

  <section id="all" class="wrap all" aria-labelledby="all-title">
    <h2 id="all-title">Documented in depth</h2>
    <p class="muted all-note">Each entry has its own page with what was at stake, what I did, what changed and the proof.</p>
    {
      years.map((y) => (
        <div class="year-group">
          <h3 class="year figure">{y.year}</h3>
          <CapsuleList items={y.items} label={`Documented in ${y.year}`} showCompany />
        </div>
      ))
    }
  </section>
</Base>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .lede {
    max-width: 38rem;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .bands {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .band-head {
    display: none;
  }

  .band-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .band-list > li {
    border-bottom: 1px solid var(--rule);
  }

  .all {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  .value {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    scroll-margin-top: 1.5rem;
  }

  .value h2 {
    font-size: var(--step-3);
    font-weight: 800;
  }

  .value .all-note {
    max-width: 36rem;
    margin-top: 1rem;
  }

  .value-body {
    margin-top: 2rem;
  }

  .all h2 {
    font-size: var(--step-3);
    font-weight: 800;
  }

  .all-note {
    max-width: 36rem;
    margin-top: 1rem;
  }

  .year-group {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .year {
    margin-bottom: 0.75rem;
    font-size: var(--step-2);
    color: var(--accent);
  }

  @media (min-width: 48rem) {
    .band-head {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
      gap: var(--gutter);
      padding-bottom: 0.75rem;
    }
  }
</style>
