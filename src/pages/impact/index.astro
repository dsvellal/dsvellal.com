---
import Base from '../../layouts/Base.astro';
import EraSection from '../../components/cards/EraSection.astro';
import { ERA_SLOT } from '../../lib/cards';
import { capsules, eras } from '../../lib/record';
import { profile } from '../../data/profile';

const work = (await eras()).filter((e) => e.lane === 'work' && e.status === 'live');
const entries = (await capsules()).filter((c) => c.lane === 'work');
const withCards = entries.filter((c) => c.tier === 'public').length;
---

<Base
  title="Impact"
  description={`${withCards} achievements since 2007 at IBM, Exeter, Amazon and Philips, each with its evidence, including the responsible use of AI in regulated medical software. Newest first, by company.`}
>
  <header class="wrap head">
    <h1>Impact</h1>
    <p class="lede">
      {withCards} achievements since 2007, newest first, grouped by company. Each card opens its evidence: what was at
      stake, what I did, what changed, and what people said. {entries.length - withCards} smaller entries are listed under
      each company.
    </p>
    <p class="focus">
      <b>{profile.aiMark}</b>
      <span>At Philips North America my work centers on {profile.focus}. Those cards carry this marker.</span>
    </p>
  </header>

  <nav class="jump" aria-label="Jump to a company">
    <ol class="wrap">
      {
        work.map((e) => (
          <li>
            <a href={`#${ERA_SLOT[e.slug]}`} data-jump={ERA_SLOT[e.slug]}>
              {e.label}
              <span>{e.years}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {work.map((e) => <EraSection era={e} limit={4} />)}
</Base>

<script>
  // Mark the company in view in the jump bar.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-jump]')].map((a) => [a.dataset.jump, a]));
  const seen = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        const a = links.get(e.target.id);
        if (!a) continue;
        a.setAttribute('aria-current', 'location');
        const bar = a.closest('ol');
        if (bar && bar.scrollWidth > bar.clientWidth) bar.scrollLeft = a.offsetLeft - bar.offsetLeft - 16;
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((_, id) => {
    const section = id ? document.getElementById(id) : null;
    if (section) seen.observe(section);
  });
</script>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .lede {
    max-width: 40rem;
    margin-top: 1.25rem;
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .focus {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    max-width: 40rem;
    margin-top: 1.25rem;
    padding-left: 1rem;
    border-left: 4px solid var(--accent);
    line-height: 1.4;
  }

  .focus b {
    padding: 0.15rem 0.5rem;
    background: var(--accent);
    font-size: var(--step--1);
  }

  .jump {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--paper);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .jump ol {
    display: flex;
    gap: 0.25rem;
    margin: 0 auto;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .jump li {
    flex: none;
  }

  .jump a {
    display: grid;
    padding: 0.7rem 0.9rem 0.6rem;
    border-bottom: 3px solid transparent;
    font-size: var(--step--1);
    font-weight: 800;
    line-height: 1.15;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .jump li:first-child a {
    padding-left: 0;
  }

  .jump a span {
    font-weight: 600;
    color: var(--ink-2);
  }

  .jump a:hover,
  .jump a[aria-current] {
    border-bottom-color: var(--accent);
  }
</style>
