---
import EraView from '../../components/record/EraView.astro';
import { eras, type Era } from '../../lib/record';

export async function getStaticPaths() {
  return (await eras())
    .filter((e) => e.status === 'live' && e.lane === 'work')
    .map((era) => ({ params: { era: era.slug }, props: { era } }));
}

const { era } = Astro.props as { era: Era };
---

<EraView era={era} />
