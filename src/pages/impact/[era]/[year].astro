---
import YearView from '../../../components/record/YearView.astro';
import { eras, type Era } from '../../../lib/record';

export async function getStaticPaths() {
  const live = (await eras()).filter((e) => e.status === 'live' && e.lane === 'work');
  return live.flatMap((era) =>
    era.year_layers.map((layer) => ({ params: { era: era.slug, year: layer.year }, props: { era, layer } })),
  );
}

const { era, layer } = Astro.props as { era: Era; layer: Era['year_layers'][number] };
---

<YearView era={era} layer={layer} />
