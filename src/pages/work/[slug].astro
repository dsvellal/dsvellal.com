---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import QuoteBlock from '../../components/QuoteBlock.astro';
import Shift from '../../components/story/Shift.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const opening = [...new Set([d.headlineClaim, ...d.shifts])];
const outcomes = d.outcomes.filter((id) => !opening.includes(id));
---

<Base title={d.title} description={d.summary} type="article">
  <article>
    <header class="wrap grid case-head">
      <div class="case-intro">
        <h1>{d.title}</h1>
        <p class="case-summary">{d.summary}</p>
        <p class="case-meta muted">{d.pillar}. {d.employer}, {d.period}.</p>
      </div>
      <dl class="case-steps">
        <div>
          <dt>Before</dt>
          <dd>{d.problem}</dd>
        </div>
        <div>
          <dt>The call</dt>
          <dd>{d.decision}</dd>
        </div>
      </dl>
      <div class="case-shifts">
        {opening.map((id) => <Shift id={id} size="full" />)}
      </div>
    </header>

    <div class="wrap grid case-body">
      <div class="prose case-prose">
        <Content />

        {
          outcomes.length > 0 && (
            <>
              <h2>Other outcomes</h2>
              <ul class="outcomes">
                {outcomes.map((id) => (
                  <li>
                    <Figure id={id} size="medium" showContext />
                  </li>
                ))}
              </ul>
            </>
          )
        }

        <h2>What I would do again</h2>
        <p>{d.doAgain}</p>
      </div>

      {
        d.quote && (
          <aside class="case-quote" aria-label="Endorsement">
            <QuoteBlock id={d.quote} />
          </aside>
        )
      }
    </div>

    <nav class="wrap next" aria-label="Next case study">
      <hr class="rule rule--accent" />
      <p class="next-title">Next: <a href={`/work/${next.id}`}>{next.data.title}</a></p>
      <p class="next-back"><a href="/#work">All four case studies</a></p>
    </nav>
  </article>
</Base>

<style>
  .case-head {
    margin-top: clamp(2rem, 6vw, 5rem);
    row-gap: 2.5rem;
  }

  .case-intro,
  .case-steps,
  .case-shifts {
    grid-column: 1 / -1;
  }

  h1 {
    margin-top: 0;
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    max-width: 18ch;
  }

  .case-summary {
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .case-meta {
    margin-top: 1rem;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .case-steps {
    display: grid;
    gap: 1.25rem var(--gutter);
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  .case-steps dt {
    font-size: var(--step--1);
    font-weight: 800;
  }

  .case-steps dd {
    max-width: 32rem;
    margin: 0.3rem 0 0;
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .case-shifts {
    display: grid;
    gap: 2rem var(--gutter);
    padding-top: 1.5rem;
    border-top: 4px solid var(--ink);
  }

  .case-body {
    margin-top: clamp(3rem, 8vw, 6rem);
    row-gap: 3rem;
  }

  .case-prose {
    grid-column: 1 / -1;
  }

  .outcomes {
    display: grid;
    gap: 2rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .outcomes li {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .case-quote {
    grid-column: 1 / -1;
    padding-top: 1.5rem;
    border-top: 4px solid var(--ink);
    align-self: start;
  }

  .next {
    margin-top: clamp(4rem, 10vw, 7rem);
  }

  .next-title {
    margin-top: 1.5rem;
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .next-back {
    margin-top: 1rem;
    font-size: var(--step--1);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .case-intro {
      grid-column: 1 / span 10;
    }

    .case-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-shifts {
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    }

    .case-prose {
      grid-column: 3 / span 6;
    }

    .case-quote {
      grid-column: 10 / span 3;
      position: sticky;
      top: 2rem;
    }
  }
</style>
