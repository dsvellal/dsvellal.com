---
import Redirect from '../../components/Redirect.astro';

// The case-study pages were retired. Each address now opens the Impact entry closest to it.
export function getStaticPaths() {
  return [
    { params: { slug: 'ai-in-regulated-software' }, props: { to: '/impact/c/2026-09-traceability-platform-adoption' } },
    { params: { slug: 'engineering-excellence-at-scale' }, props: { to: '/impact/c/2022-craftsmanship-assessment-67-to-78' } },
    { params: { slug: 'scaling-people' }, props: { to: '/impact/c/2021-senior-hiring-redesign' } },
    { params: { slug: 'tech-debt-at-scale' }, props: { to: '/impact/c/2021-tech-debt-savings-program' } },
  ];
}

const { to } = Astro.props;
---

<Redirect to={to} />
