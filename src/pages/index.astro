---
import Base from '../layouts/Base.astro';
import Headshot from '../components/Headshot.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import VouchMap from '../components/story/VouchMap.astro';
import Signals from '../components/story/Signals.astro';
import EraStrip from '../components/cards/EraStrip.astro';
import { profile } from '../data/profile';
import { claim } from '../data/claims';
import { heroLead, heroStrip, readingPaths } from '../data/story';
import { trio } from '../data/endorsements';
import { capsules, claimHref } from '../lib/record';

const years = claim('years-experience');
const lead = { ...claim(heroLead), href: await claimHref(claim(heroLead)) };
const strip = await Promise.all(heroStrip.map(async (id) => ({ ...claim(id), href: await claimHref(claim(id)) })));
const withCards = (await capsules()).filter((c) => c.lane === 'work' && c.tier === 'public').length;
const paths = [
  { href: '/impact', title: 'See the Impact', body: `${withCards} achievements with their evidence, newest first, by company.` },
  ...readingPaths,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  alternateName: profile.name,
  jobTitle: profile.role,
  description: profile.headline,
  url: 'https://dsvellal.com',
  email: `mailto:${profile.email}`,
  sameAs: [profile.linkedin],
  worksFor: { '@type': 'Organization', name: 'Philips' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'RV College of Engineering' },
  award: ['CTO Outstanding Technical Achievement Award, Philips, 2021'],
  address: { '@type': 'PostalAddress', addressLocality: 'Rochester', addressRegion: 'MI', addressCountry: 'US' },
  knowsAbout: [
    'Responsible use of AI in regulated medical software development and delivery',
    'IEC 62304',
    'Engineering excellence',
    'DORA metrics',
    'Technical debt reduction',
    'Hiring process design',
  ],
};
---

<Base
  title={profile.name}
  description={`${profile.headline} ${years.value} across ${profile.employers.join(', ')}.`}
  type="profile"
  jsonLd={jsonLd}
>
  <section class="hero wrap grid" aria-labelledby="hero-title">
    <div class="hero-photo">
      <Headshot />
    </div>
    <p class="hero-id">
      <span>{profile.role}</span>
      <span class="muted">{profile.location}</span>
    </p>
    <div class="hero-copy">
      <h1 id="hero-title">{profile.headline}</h1>
      <a class="lead" href={lead.href}>
        <span class="lead-n figure">{lead.value}</span>
        <span class="lead-l">{lead.short ?? lead.label}</span>
      </a>
      <ul class="hero-strip" aria-label="More in numbers">
        {
          strip.map((c) => (
            <li>
              <a href={c.href}>
                <b class="figure">{c.value}</b>
                <span>{c.short ?? c.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="strip-wrap">
    <EraStrip />
  </div>

  <section class="wrap vouch" aria-labelledby="vouch-title">
    <hr class="rule rule--accent" />
    <h2 id="vouch-title" class="section-title">Who vouches for the work</h2>
    <div class="section-body">
      <VouchMap />
    </div>
    <div class="trio">
      <h3 class="trio-title">Three LinkedIn recommendations from 2025</h3>
      <div class="trio-grid">
        {trio.map((t) => <QuoteBlock id={t.quote} relation={t.relation} showContext={false} />)}
      </div>
      <p class="more">
        <a href={profile.linkedinRecommendations}>Read them all on LinkedIn</a>
      </p>
    </div>
    <div class="called-out">
      <h3 class="trio-title">Called out</h3>
      <Signals />
    </div>
    <p class="more"><a href="/endorsements">Every recorded voice, grouped by who said it</a></p>
  </section>

  <nav class="wrap paths" aria-labelledby="paths-title">
    <hr class="rule" />
    <h2 id="paths-title" class="section-title">Where to go next</h2>
    <ul class="path-list">
      {
        paths.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <p class="muted">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>

<style>
  section,
  .paths,
  .strip-wrap {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .section-title {
    margin-top: 1.5rem;
    font-size: var(--step-3);
    font-weight: 800;
  }

  .section-body {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .more {
    margin-top: 2rem;
    font-size: var(--step--1);
    font-weight: 700;
  }

  /* Hero: face, headline, one number, a strip of three more, then actions. */
  .hero {
    margin-top: clamp(1.25rem, 4vw, 3.5rem);
    row-gap: 1.5rem;
    align-items: end;
  }

  .hero-photo {
    grid-column: 1 / span 2;
    grid-row: 1;
  }

  .hero-id {
    display: grid;
    gap: 0.25rem;
    grid-column: 3 / span 2;
    grid-row: 1;
    align-self: end;
    padding-bottom: 2.25rem;
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.3;
  }

  .hero-copy {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  h1 {
    margin-top: 0;
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 20ch;
  }

  .lead {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 4px solid var(--accent);
    color: inherit;
    text-decoration: none;
  }

  .lead-n {
    font-size: clamp(4rem, 3rem + 7vw, 7.5rem);
    color: var(--accent);
  }

  .lead-l {
    max-width: 22rem;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
  }

  .lead:hover .lead-l {
    text-decoration: underline;
  }

  .hero-strip {
    display: flex;
    gap: 0.75rem;
    margin: 1.5rem calc(var(--margin) * -1) 0;
    padding: 0 var(--margin) 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margin);
    list-style: none;
    scrollbar-width: none;
  }

  .hero-strip li {
    flex: 0 0 min(62vw, 15rem);
    scroll-snap-align: start;
  }

  .hero-strip a {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 0.9rem 1rem 1rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }

  .hero-strip b {
    font-size: var(--step-2);
  }

  .hero-strip span {
    font-size: var(--step--1);
    line-height: 1.3;
  }

  .hero-strip a:hover {
    background: var(--accent);
    color: var(--ink);
  }

  @media (min-width: 48rem) {
    .hero {
      align-items: start;
    }

    .hero-copy {
      grid-column: 1 / span 8;
      grid-row: 1 / span 2;
    }

    .hero-photo {
      grid-column: 10 / span 3;
      grid-row: 1;
      margin-top: 0.5rem;
    }

    .hero-id {
      grid-column: 10 / span 3;
      grid-row: 2;
      align-self: start;
      padding-bottom: 0;
    }

    .hero-strip {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
  }

  /* Vouch */
  .trio,
  .called-out {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .trio-title {
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .trio-grid {
    display: grid;
    gap: 2.5rem var(--gutter);
    margin-top: 1.75rem;
  }

  .called-out :global(.signals) {
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .trio-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Paths */
  .path-list {
    display: grid;
    gap: 1.5rem var(--gutter);
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .path-list li {
    padding-top: 1rem;
    border-top: 4px solid var(--ink);
  }

  .path-list li:first-child {
    border-top-color: var(--accent);
  }

  .path-list a {
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .path-list p {
    max-width: 22rem;
    margin-top: 0.5rem;
    font-size: var(--step--1);
  }

  @media (min-width: 48rem) {
    .path-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .path-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
