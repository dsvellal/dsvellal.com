---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/record/Breadcrumbs.astro';
import NumbersStrip from '../../components/record/NumbersStrip.astro';
import RecordQuote from '../../components/record/RecordQuote.astro';
import { capsules, eras, type Era } from '../../lib/record';

export async function getStaticPaths() {
  return (await eras()).filter((e) => e.status === 'live').map((era) => ({ params: { era: era.slug }, props: { era } }));
}

const { era } = Astro.props as { era: Era };
const all = (await capsules()).filter((c) => c.era === era.slug);
const byId = new Map(all.map((c) => [c.id, c]));
const company = era.company;
const showTook = Boolean(company?.took);
---

<Base title={`${era.label}, ${era.years}`} description={`What I delivered at ${era.label}, ${era.years}: ${era.headline}.`}>
  <header class="wrap head">
    <Breadcrumbs items={[{ label: 'Record', href: '/record' }, { label: era.label }]} />
    <h1>{era.label}</h1>
    <p class="lede">{era.years}. {all.length} events, {era.public} documented in depth.</p>
  </header>

  {
    company && (
      <>
        {company.arc.length > 0 && (
          <section class="wrap grid block" aria-labelledby="arc-title">
            <h2 id="arc-title" class="side">Role</h2>
            <ol class="arc main">
              {company.arc.map((a) => (
                <li>
                  <span class="label">{a.when}</span>
                  <span>{a.what}</span>
                </li>
              ))}
            </ol>
          </section>
        )}

        {company.scope.length > 0 && (
          <section class="wrap grid block" aria-labelledby="scope-title">
            <h2 id="scope-title" class="side">Scope and responsibilities</h2>
            <ul class="scope main">
              {company.scope.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        <section class="wrap grid block" aria-labelledby="sig-title">
          <h2 id="sig-title" class="side">Signature work</h2>
          <ol class="signatures main">
            {company.signatures.map((s, i) => {
              const target = s.capsule ? byId.get(s.capsule) : undefined;
              return (
                <li>
                  <span class="figure num">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{s.title}</h3>
                    <p class="muted">{s.body}</p>
                    {target?.tier === 'public' && (
                      <p class="more">
                        <a href={`/record/c/${target.id}`}>See the evidence</a>
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>

        <section class="wrap block">
          <h2 class="visually-hidden">In numbers</h2>
          <NumbersStrip items={company.numbers} />
        </section>

        {company.quotes.length > 0 && (
          <section class="wrap grid block quotes" aria-labelledby="voices-title">
            <h2 id="voices-title" class="visually-hidden">What people said</h2>
            {company.quotes.map((q, i) => (
              <div class:list={['q', { first: i === 0 }]}>
                <RecordQuote quote={q} size={i === 0 ? 'large' : 'regular'} link />
              </div>
            ))}
          </section>
        )}
      </>
    )
  }

  <section class="wrap grid block" aria-labelledby="years-title">
    <h2 id="years-title" class="side">Year by year</h2>
    <ol class="years main">
      {
        era.year_layers.map((y) => (
          <li>
            <a class="year figure" href={`/record/${era.slug}/${y.year}`}>
              {y.year}
            </a>
            <div>
              <p>{y.narrative}</p>
              <p class="label muted">{y.count} {y.count === 1 ? 'event' : 'events'}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    showTook && (
      <section class="wrap grid block" aria-labelledby="took-title">
        <h2 id="took-title" class="side">What I took from it</h2>
        <div class="main prose">
          <p>{company?.took}</p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  h1 {
    margin-top: 1.5rem;
    font-size: var(--step-5);
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .lede {
    margin-top: 1rem;
    font-size: var(--step-1);
  }

  .block {
    margin-top: clamp(3rem, 7vw, 5rem);
    row-gap: 1.25rem;
  }

  .side,
  .main {
    grid-column: 1 / -1;
  }

  .side {
    font-size: var(--step-2);
  }

  .arc,
  .scope,
  .signatures,
  .years {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .scope li {
    max-width: 44rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .arc li {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .signatures li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--gutter);
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .num {
    font-size: var(--step-2);
    color: var(--accent);
  }

  .signatures h3 {
    font-size: var(--step-1);
  }

  .signatures p.muted {
    max-width: 40rem;
    margin-top: 0.5rem;
  }

  .more {
    margin-top: 0.75rem;
    font-weight: 600;
  }

  .quotes {
    border-top: 1px solid var(--ink);
    padding-top: 2rem;
    row-gap: 2rem;
  }

  .q {
    grid-column: 1 / -1;
  }

  .years li {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--gutter);
    align-items: baseline;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .year {
    font-size: var(--step-2);
  }

  .years .label {
    margin-top: 0.5rem;
  }

  @media (min-width: 48rem) {
    .side {
      grid-column: 1 / span 3;
    }

    .main {
      grid-column: 4 / span 9;
    }

    .arc li {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: var(--gutter);
    }

    .q.first {
      grid-column: 1 / span 7;
    }

    .q:not(.first) {
      grid-column: 9 / span 4;
    }
  }
</style>
