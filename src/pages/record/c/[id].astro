---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/record/Breadcrumbs.astro';
import RecordQuote from '../../../components/record/RecordQuote.astro';
import { capsules, eras, formatDate, monthShort, THEME_LABELS, type Capsule } from '../../../lib/record';

export async function getStaticPaths() {
  const all = await capsules();
  const eraList = await eras();
  return all
    .filter((c) => c.tier === 'public')
    .map((c) => {
      const siblings = all.filter((s) => s.era === c.era && s.tier === 'public');
      const i = siblings.findIndex((s) => s.id === c.id);
      return {
        params: { id: c.id },
        props: {
          capsule: c,
          eraLabel: eraList.find((e) => e.slug === c.era)?.label ?? c.company,
          prev: siblings[i - 1],
          next: siblings[i + 1],
        },
      };
    });
}

const { capsule: c, eraLabel, prev, next } = Astro.props as {
  capsule: Capsule;
  eraLabel: string;
  prev?: Capsule;
  next?: Capsule;
};
const sections = [
  { label: 'What would have happened', text: c.what_would_have_happened },
  { label: 'The call', text: c.the_call },
  { label: 'What I did', text: c.what_i_did },
  { label: 'What changed', text: c.what_changed },
].filter((s) => s.text && !/^not (applicable|in sources)/i.test(s.text));
const crumbs = [
  { label: 'Record', href: '/record' },
  { label: eraLabel, href: `/record/${c.era}` },
  { label: c.year, href: `/record/${c.era}/${c.year}` },
  ...(c.month ? [{ label: monthShort(c.month), href: `/record/${c.era}/${c.year}/${c.month}` }] : []),
  { label: c.title },
];
const images = c.images ?? [];
const quotes = c.quotes ?? [];
const metrics = (c.metrics ?? []).slice(0, 3);
---

<Base title={c.title} description={c.summary ?? c.title} type="article">
  <article>
    <header class="wrap head">
      <Breadcrumbs items={crumbs} />
      <p class="meta label muted">
        {formatDate(c.date)}, {c.company}. {c.type}
      </p>
      <h1>{c.title}</h1>
      {c.summary && <p class="lede">{c.summary}</p>}
      {
        c.themes.length > 0 && (
          <ul class="themes" aria-label="Themes">
            {c.themes.map((t) => (
              <li class="label">{THEME_LABELS[t] ?? t}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      metrics.length > 0 && (
        <section class="wrap metrics" aria-label="Key numbers">
          {metrics.map((m) => (
            <div class="metric">
              <p class="figure value">{m.value}</p>
              <p class="text">{m.label}</p>
              {m.context && <p class="context muted">{m.context}</p>}
            </div>
          ))}
        </section>
      )
    }

    <div class="wrap story">
      {
        sections.map((s) => (
          <section class="grid part">
            <h2 class="side">{s.label}</h2>
            <p class="main">{s.text}</p>
          </section>
        ))
      }

      <section class="grid part">
        <h2 class="side">Proof</h2>
        <div class="main">
          {
            images.length > 0 ? (
              <div class="shots">
                {images.map((img) => (
                  <figure>
                    <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                    {img.pending && (
                      <figcaption class="label muted">
                        <span class="pending">Pending review</span>
                      </figcaption>
                    )}
                  </figure>
                ))}
              </div>
            ) : (
              <p class="muted">The original documents are held in my private record and can be shared on request.</p>
            )
          }
        </div>
      </section>

      {
        quotes.length > 0 && (
          <section class="grid part">
            <h2 class="side">What people said</h2>
            <div class="main voices">
              {quotes.map((q) => (
                <RecordQuote quote={q} />
              ))}
            </div>
          </section>
        )
      }
    </div>

    <nav class="wrap pager" aria-label="More from this era">
      {prev ? <a href={`/record/c/${prev.id}`}>Previous: {prev.title}</a> : <span />}
      {next && <a class="next" href={`/record/c/${next.id}`}>Next: {next.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .meta {
    margin-top: 2rem;
  }

  h1 {
    max-width: 56rem;
    margin-top: 0.75rem;
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 44rem;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .themes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .themes li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--ink);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 2rem var(--gutter);
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 4px solid var(--accent);
  }

  .value {
    font-size: var(--step-4);
    color: var(--accent);
  }

  .metric .text {
    max-width: 18rem;
    margin-top: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .metric .context {
    max-width: 18rem;
    margin-top: 0.35rem;
    font-size: var(--step--1);
  }

  .story {
    margin-top: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--ink);
  }

  .part {
    row-gap: 0.75rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .side,
  .main {
    grid-column: 1 / -1;
  }

  .side {
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  p.main,
  .main > p {
    max-width: 44rem;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .shots {
    display: grid;
    gap: 2rem;
  }

  figure {
    margin: 0;
  }

  figure img {
    width: 100%;
    max-width: 48rem;
    border: 1px solid var(--rule);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 0.75rem;
  }

  .pending {
    padding: 0.15rem 0.5rem;
    background: var(--ink);
    color: var(--paper);
  }

  .voices {
    display: grid;
    gap: 2rem;
  }

  .pager {
    display: grid;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .side {
      grid-column: 1 / span 3;
    }

    .main {
      grid-column: 4 / span 9;
    }

    .pager {
      grid-template-columns: 1fr 1fr;
      gap: var(--gutter);
    }

    .pager .next {
      text-align: right;
    }
  }
</style>
